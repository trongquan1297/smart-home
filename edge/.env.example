# Sao chép thành .env rồi điền. KHÔNG commit .env (chứa token và mật khẩu).
CLOUD_WS_URL=wss://api.example.com/gw/ws
GATEWAY_TOKEN=           # tạo trong app: Căn hộ → Gateway → Thêm (chỉ hiển thị một lần)
ZIGBEE_DEVICE=/dev/serial/by-id/usb-REPLACE_ME   # xem `ls /dev/serial/by-id/`
# MATTER_SWITCH_AS=light   # light | outlet | switch
# MATTERBRIDGE_PASSWORD=   # chỉ khi bạn đã đặt mật khẩu cho frontend Matterbridge

# Mật khẩu MQTT: để ./gen-secrets.sh điền (MQTT_PASSWORD_Z2M / _GATEWAY / _MATTERBRIDGE).
