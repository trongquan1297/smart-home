POSTGRES_PASSWORD=smart_dev_pw
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Điền sau khi chạy scripts/bootstrap-dev.sh
GATEWAY_TOKEN=
# Production: wss://api.your-domain.com/gw/ws
CLOUD_WS_URL=ws://backend:8080/gw/ws
# Zigbee2MQTT thật: đường dẫn dongle trên Pi
ZIGBEE_DEVICE=/dev/ttyUSB0
# Google Home cloud-to-cloud (liên kết tài khoản OAuth 2.0). Để trống = tắt.
# Client id/secret do mình tự đặt (secret: openssl rand -hex 32) rồi nhập vào Google Home Developer Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
# Report State + Request Sync (HomeGraph): khoá JSON service account đặt trong ./secrets
GOOGLE_HOMEGRAPH_SA_FILE=
# Đăng nhập app bằng Google / Apple (để trống = tắt). Xem README mục "Đăng nhập bằng Google / Apple".
GOOGLE_SIGNIN_CLIENT_IDS=      # client iOS + client Web, phân tách bằng dấu phẩy
GOOGLE_SIGNIN_WEB_CLIENT_ID=   # client Web (nút Google trên trang liên kết Google Home)
APPLE_SIGNIN_CLIENT_IDS=       # bundle ID app iOS, vd com.newmoon22.msmart
APPLE_SIGNIN_WEB_SERVICE_ID=   # Services ID (nút Apple trên trang liên kết Google Home)
APPLE_TEAM_ID=                 # Team ID Apple Developer
APPLE_SIGNIN_KEY_ID=           # Key ID của khoá "Sign in with Apple" (.p8)
APPLE_SIGNIN_KEY_FILE=         # vd /run/secrets/AuthKey_XXXX.p8 — thu hồi token Apple khi xoá tài khoản
# Cloudflare Tunnel (profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
